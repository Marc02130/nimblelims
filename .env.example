# NimbleLIMS environment variables — copy to .env and fill in real values
# Never commit .env (it's in .gitignore)

# Database — runtime should be lims_app; migrator/ensure use owner URL (P0d)
DATABASE_URL=postgresql://lims_app:lims_app_password@localhost:5432/lims_db
MIGRATE_DATABASE_URL=postgresql://lims_user:lims_password@localhost:5432/lims_db
LIMS_APP_PASSWORD=lims_app_password
# ENSURE_LIMS_APP_PASSWORD_ROTATE=false

# JWT (S3) — set a strong random SECRET_KEY in any non-local environment.
# Precedence: SECRET_KEY, then JWT_SECRET_KEY.
# Placeholder secrets are refused unless ENVIRONMENT=development|test AND
# ALLOW_INSECURE_DEFAULTS=true.
SECRET_KEY=change-me-to-a-long-random-string
# JWT_SECRET_KEY=  # optional alias if SECRET_KEY unset
ENVIRONMENT=development
ALLOW_INSECURE_DEFAULTS=true
ALLOW_DEV_SEED_USERS=true
# Production bootstrap (create_admin.py): complex password, not a README default
# BOOTSTRAP_ADMIN_PASSWORD=

# Password reset email (production). Leave SMTP_HOST empty to disable.
# The sign-in page still shows Forgot password?; the API then says mail is not available.
# Local Compose already runs Mailpit. Open http://localhost:8025. SMTP is the
# mail service on port 1025 with SMTP_TLS=false. Do not publish that port.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=lims@example.com
# SMTP_TLS=true
# SMTP_SSL=false
# PUBLIC_APP_URL=https://lims.example.com
# PASSWORD_RESET_TTL_MINUTES=60
# PASSWORD_RESET_MAX_PER_HOUR=3

# Anthropic Claude API — required for SOP parsing
ANTHROPIC_API_KEY=sk-ant-...
