# NimbleLIMS environment variables — copy to .env and fill in real values
# Never commit .env (it's in .gitignore)

# Database — runtime should be lims_app; migrator/ensure use owner URL (P0d)
DATABASE_URL=postgresql://lims_app:lims_app_password@localhost:5432/lims_db
MIGRATE_DATABASE_URL=postgresql://lims_user:lims_password@localhost:5432/lims_db
LIMS_APP_PASSWORD=lims_app_password
# ENSURE_LIMS_APP_PASSWORD_ROTATE=false

# JWT (S3) — set a strong random SECRET_KEY in any non-local environment.
# Precedence: SECRET_KEY, then JWT_SECRET_KEY.
# Placeholder secrets are refused unless ENVIRONMENT=development|test AND
# ALLOW_INSECURE_DEFAULTS=true.
SECRET_KEY=change-me-to-a-long-random-string
# JWT_SECRET_KEY=  # optional alias if SECRET_KEY unset
ENVIRONMENT=development
ALLOW_INSECURE_DEFAULTS=true
ALLOW_DEV_SEED_USERS=true
# Production bootstrap (create_admin.py): complex password, not a README default
# BOOTSTRAP_ADMIN_PASSWORD=

# Dev/UAT seed persona passwords. Read by backend/seed_dev_passwords.py and UAT_Scripts runners.
# Leave unset to have seed_dev_passwords.py --apply generate and print each once. Never commit real values.
# DEV_SEED_ADMIN_PASSWORD=
# DEV_SEED_LAB_MANAGER_PASSWORD=
# DEV_SEED_LAB_TECH_PASSWORD=
# DEV_SEED_CLIENT_PASSWORD=
# DEV_SEED_ALICE_TECH_PASSWORD=
# DEV_SEED_BOB_TECH_PASSWORD=
# DEV_SEED_CAROL_MANAGER_PASSWORD=
# DEV_SEED_DAVID_CRO_PASSWORD=
# UAT_TEMP_PASSWORD=
# Slice users (backend/seed_config_agent_slice.py). Same rule: unset means print once.
# SLICE_REVIEWER_PASSWORD=
# SLICE_SCHEMA_EDITOR_PASSWORD=

# Password reset email (production). Leave SMTP_HOST empty to disable.
# The sign-in page still shows Forgot password?; the API then says mail is not available.
# Local Compose already runs Mailpit. Open http://localhost:8025. SMTP is the
# mail service on port 1025 with SMTP_TLS=false. Do not publish that port.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=lims@example.com
# SMTP_TLS=true
# SMTP_SSL=false
# PUBLIC_APP_URL=https://lims.example.com
# PASSWORD_RESET_TTL_MINUTES=60
# PASSWORD_RESET_MAX_PER_HOUR=3

# Anthropic Claude API — required for SOP parsing
ANTHROPIC_API_KEY=sk-ant-...

# Configuring agent. local embeddings match ragged (all-MiniLM-L6-v2, 384-d). Tests use stub.
EMBEDDING_PROVIDER=local
# Optional fallbacks when no key is stored on Configuring agent settings. One provider per run.
# OPENAI_API_KEY=
# XAI_API_KEY=

# MCP server (services/mcp). Compose sets the in-network URL and read-only default.
# Never put a real token in this file.
# BACKEND_BASE_URL=http://localhost:8000
# MCP_READ_ONLY=true
# MCP_HOST=0.0.0.0
# MCP_PORT=8100
# MCP_TRANSPORT=streamable-http
# NIMBLELIMS_ACCESS_TOKEN=
