# NimbleLIMS environment variables — copy to .env and fill in real values
# Never commit .env (it's in .gitignore)

# Database
DATABASE_URL=postgresql://lims_user:lims_password@localhost:5432/lims_db

# JWT (S3) — set a strong random SECRET_KEY in any non-local environment.
# Precedence: SECRET_KEY, then JWT_SECRET_KEY.
# Placeholder secrets are refused unless ENVIRONMENT=development|test AND
# ALLOW_INSECURE_DEFAULTS=true.
SECRET_KEY=change-me-to-a-long-random-string
# JWT_SECRET_KEY=  # optional alias if SECRET_KEY unset
ENVIRONMENT=development
ALLOW_INSECURE_DEFAULTS=true
ALLOW_DEV_SEED_USERS=true

# Anthropic Claude API — required for SOP parsing
ANTHROPIC_API_KEY=sk-ant-...
