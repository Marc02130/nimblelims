# Database Configuration
DATABASE_URL=postgresql://lims_app:change-me@db:5432/lims_db
DB_HOST=db
DB_PORT=5432
DB_NAME=lims_db
DB_USER=lims_app
DB_PASSWORD=change-me
MIGRATE_DATABASE_URL=postgresql://lims_migrate:change-me@db:5432/lims_db
LIMS_APP_PASSWORD=change-me
LIMS_MIGRATE_PASSWORD=change-me

# JWT Configuration
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Configuration
DEBUG=True
ENVIRONMENT=development
# The lab timezone is required. It is stored in lab_settings.timezone and set
# by an administrator at the required post-login step, or with PATCH /v1/lab-settings.
# There is no environment fallback. current_lab_day() raises until it is set.

# Optional: SOP extraction (POST /v1/sop-parse) uses the configuring agent's provider settings, else the first
# of ANTHROPIC_API_KEY, OPENAI_API_KEY, XAI_API_KEY set here. With none, parse jobs fail with a clear error.
# ANTHROPIC_API_KEY=

# Configuring agent embeddings. local = sentence-transformers/all-MiniLM-L6-v2 (384-d), same as ragged.
# Tests use stub. Do not put a real provider key in this file.
EMBEDDING_PROVIDER=local
# OPENAI_API_KEY=
# XAI_API_KEY=
# ANTHROPIC_API_KEY=
