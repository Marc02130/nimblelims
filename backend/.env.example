# Database Configuration (P0d: app = lims_app, migrate/ensure = lims_user)
DATABASE_URL=postgresql://lims_app:lims_app_password@db:5432/lims_db
MIGRATE_DATABASE_URL=postgresql://lims_user:lims_password@db:5432/lims_db
LIMS_APP_PASSWORD=lims_app_password
DB_HOST=db
DB_PORT=5432
DB_NAME=lims_db
DB_USER=lims_app
DB_PASSWORD=lims_app_password

# JWT Configuration (S3) — SECRET_KEY preferred; JWT_SECRET_KEY is alias
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Configuration
DEBUG=True
ENVIRONMENT=development
# Required to use placeholder secrets / well-known UAT users locally (never in prod)
ALLOW_INSECURE_DEFAULTS=true
ALLOW_DEV_SEED_USERS=true
# BOOTSTRAP_ADMIN_PASSWORD=  # production admin create (complexity enforced)
