# Database Configuration (runtime lims_app, migrations lims_migrate)
DATABASE_URL=postgresql://lims_app:change-me@db:5432/lims_db
MIGRATE_DATABASE_URL=postgresql://lims_migrate:change-me@db:5432/lims_db
LIMS_APP_PASSWORD=change-me
LIMS_MIGRATE_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
DB_NAME=lims_db
DB_USER=lims_app
DB_PASSWORD=change-me

# JWT Configuration (S3) — SECRET_KEY preferred; JWT_SECRET_KEY is alias
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Configuration
DEBUG=True
ENVIRONMENT=development
# The lab timezone is required. It is stored in lab_settings.timezone and set
# by an administrator at the required post-login step, or with PATCH /v1/lab-settings.
# There is no environment fallback. current_lab_day() raises until it is set.
# Required to use placeholder secrets / well-known UAT users locally (never in prod)
ALLOW_INSECURE_DEFAULTS=true
ALLOW_DEV_SEED_USERS=true
# BOOTSTRAP_ADMIN_PASSWORD=  # production admin create (complexity enforced)

# Configuring agent embeddings (ragged: all-MiniLM-L6-v2, 384-d). Tests set stub.
EMBEDDING_PROVIDER=local
# OPENAI_API_KEY=
# XAI_API_KEY=
# ANTHROPIC_API_KEY=

# Password reset email. Empty SMTP_HOST disables sending (same 503 for every caller).
# Local Compose uses Mailpit instead of these values. Inbox: http://localhost:8025.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=lims@example.com
# SMTP_TLS=true
# SMTP_SSL=false
# PUBLIC_APP_URL=http://localhost:3000
# PASSWORD_RESET_TTL_MINUTES=60
# PASSWORD_RESET_MAX_PER_HOUR=3
