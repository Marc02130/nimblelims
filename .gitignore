# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
ENV/

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Tests / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage/
*.cover
.hypothesis/
.cache

# --- Node / CRA (frontend) ---
node_modules/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
*.tsbuildinfo

# --- IDE / OS ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Docs ---
# Published operator how-tos (committed): /manuals/  (e.g. HOWTO.md)
# Working PRDs/specs/design under .docs/internal/ are git-tracked
# Legacy vendor dumps / old operator manuals under .docs/manuals/ stay local-only (not git)
.docs/manuals/

# Vendor / third-party PDFs must not sit in published /manuals/
/manuals/**/*.pdf

# --- Tooling ---
.gstack/
# Commit shared Grok skills + teams; ignore local settings
.grok/*
!.grok/skills/
!.grok/skills/**
!.grok/teams/
!.grok/teams/**

# --- Local dumps ---
TestData/
*.db
*.sqlite
*.sqlite3
logs/
*.log
tmp/
temp/
